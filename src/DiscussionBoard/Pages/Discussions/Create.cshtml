@page
@model DiscussionBoard.Pages.Discussions.CreateModel

@{
    ViewData["Title"] = "Create Discussion";
}

<h1>Create Discussion</h1>

<form method="post" asp-route-forumId="@Model.ForumId">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-4">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Content" class="form-label"></label>
        <textarea asp-for="Input.Content" class="form-control" rows="10"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Discussion
    </button>

    <a asp-page="/Forums/Details"
       asp-route-id="@Model.ForumId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
