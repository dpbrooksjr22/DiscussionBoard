@page
@model DiscussionBoard.Pages.Discussions.EditModel

@{
    ViewData["Title"] = "Edit Discussion";
}

<h1>Edit Discussion</h1>

<form method="post" asp-route-id="@Model.ThreadId">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content" class="form-label"></label>
        <textarea asp-for="Input.Content"
                  class="form-control"
                  rows="5"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="/Forums/Details"
       asp-route-id="@Model.ForumId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
